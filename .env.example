# 이 파일을 .env.local로 복사해 값을 채우세요. .env.local은 git에 올리지 않습니다.

# 백엔드 주소 (개발 중에는 Vite 프록시가 /api 요청을 이 주소로 보냅니다)
VITE_API_BASE_URL=http://localhost:8080

# true면 MSW 목업으로 동작합니다. 실제 백엔드에 붙일 때 false
VITE_API_MOCKING=true

# 카카오맵 JavaScript 키 (카카오 개발자 콘솔에 사용할 도메인·포트 등록 필요)
VITE_KAKAO_MAP_APP_KEY=

# 구글 OAuth 클라이언트 ID와 리다이렉트 주소 (구글 클라우드 콘솔에 같은 주소 등록 필요)
VITE_GOOGLE_CLIENT_ID=
VITE_GOOGLE_REDIRECT_URI=http://localhost:3100/oauth/google/callback
VITE_GOOGLE_CALENDAR_REDIRECT_URI=http://localhost:3100/oauth/google/calendar/callback
